{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ronda-quiz-en-vivo",
  "main": "services/worker.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "vars": {
    "PUBLIC_BASE_URL": "https://fncolque.github.io/quiz-en-vivo/",
  },
  "version_metadata": { "binding": "WORKER_VERSION" },
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "CATALOG", "class_name": "QuizCatalog" },
      { "name": "ROOMS", "class_name": "QuizRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuizCatalog", "QuizRoom"] },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
